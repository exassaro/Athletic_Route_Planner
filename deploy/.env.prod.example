# Production settings for deploy/docker-compose.prod.yml. Copy with deploy/gen_secrets.sh, which writes
# deploy/.env.prod (chmod 600, gitignored) with a random Postgres password. Never commit .env.prod.
# Read twice: by compose for ${...} in the compose file (--env-file), and by the api container (env_file).

# --- Secrets -------------------------------------------------------------------------------------------------
# Postgres password, hex only (it goes into a URL). Read by Postgres only when data/postgres is first created.
POSTGRES_PASSWORD=change-me-run-gen_secrets

# --- Public addresses ----------------------------------------------------------------------------------------
# Caddy's site address (a hostname: automatic HTTPS) and the front end's origin (CORS on /basemap/*).
API_SITE=api.gatho.shahinsha.xyz
WEB_ORIGIN=https://gatho.shahinsha.xyz

# --- API (athlete_api/config.py; every ATHLETE_* setting can be set here) ------------------------------------
# Browser origins allowed to call /v1: exactly the front end, no trailing slash, comma-separated if more.
ATHLETE_CORS_ORIGINS=https://gatho.shahinsha.xyz

# Solve slots (Phase 4 amendment 3): 2 on 2 vCPU.
ATHLETE_SOLVE_SLOTS=2

# Rate limits (Phase 4 amendment 22 and Phase 5c amendment 10). Defaults shown.
ATHLETE_RATE_SOLVE_PER_CLIENT_MIN=20
ATHLETE_RATE_SOLVE_PER_IP_MIN=40
ATHLETE_RATE_READ_PER_CLIENT_MIN=300
ATHLETE_RATE_WRITE_PER_CLIENT_MIN=60
ATHLETE_RATE_SESSION_PER_IP_HOUR=10

# Set by the compose file, not here: ATHLETE_DATABASE_URL, ATHLETE_REDIS_URL, VALHALLA_URL, GRAPHHOPPER_URL,
# ATHLETE_PHOTON_URL, ATHLETE_TRUST_FORWARDED_FOR=true, FORWARDED_ALLOW_IPS.
